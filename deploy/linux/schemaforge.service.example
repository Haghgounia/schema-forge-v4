# Example only. Install as /etc/systemd/system/schemaforge.service after
# tailoring paths and creating a dedicated, unprivileged schemaforge user.
[Unit]
Description=SchemaForge V4 Java API (localhost only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=schemaforge
Group=schemaforge
WorkingDirectory=/opt/schemaforge
EnvironmentFile=-/etc/schemaforge/schemaforge.env
ExecStart=/usr/bin/java -jar /opt/schemaforge/bin/schema-forge-v4-4.0.1.jar --spring.config.location=file:/etc/schemaforge/application.yml --server.address=127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
